{
  "name": "anime-video-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turns a shot spec into an anime-style video by driving Blender, Krita, SoX and ffmpeg headless.",
  "engines": { "node": ">=24" },
  "bin": { "harness": "src/cli/main.ts" },
  "scripts": {
    "harness": "node src/cli/main.ts",
    "test": "node --test tests/unit/",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
